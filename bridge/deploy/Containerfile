# syntax=docker/dockerfile:1

# ---- build -------------------------------------------------------------------
# Builds cmux-relay as a static, CGO-free binary so the runtime image stays
# tiny. Built for the builder's native architecture — build this image on the
# host it runs on (the Linux server); do not ship the image across architectures.
FROM golang:1.26-bookworm AS build
WORKDIR /src

# Cache module downloads independently of source changes.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cmux-relay ./cmd/cmux-relay

# ---- runtime -----------------------------------------------------------------
FROM alpine:3.20
# /data is created here so a fresh named volume inherits app ownership via
# podman's copy-up; the device-token store is written there at runtime.
RUN apk add --no-cache ca-certificates \
    && adduser -D -u 10001 app \
    && mkdir -p /data && chown app:app /data
COPY --from=build /out/cmux-relay /usr/local/bin/cmux-relay
USER app
EXPOSE 8765
# config.toml is bind-mounted at /etc/cmux-relay/config.toml (see compose).
ENTRYPOINT ["/usr/local/bin/cmux-relay"]
CMD ["serve", "--config", "/etc/cmux-relay/config.toml"]
